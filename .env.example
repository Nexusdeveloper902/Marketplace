# Database
# PostgreSQL is the production datasource. For local development, point this
# at a local Postgres instance or a hosted one (Supabase/Neon). The connection
# string below is a template — replace the placeholders.
#
# Two URLs are used so runtime queries and migrations don't share a pool:
#   DATABASE_URL — runtime (serverless) queries. Use the Supabase transaction
#     pooler (port 6543) with ?pgbouncer=true&connection_limit=1 so many
#     short-lived serverless functions share a small backend pool.
#   DIRECT_URL   — migrations (prisma migrate deploy). Use the direct
#     connection (db.* host, port 5432); the transaction pooler rejects the
#     prepared statements Prisma Migrate needs.
#
# Local Postgres (use the same direct connection for both):
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/luxicar"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/luxicar"
#
# Supabase (production / Vercel):
# DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres"

# Authentication
# Secret used to sign session JWTs. Generate one with: openssl rand -hex 32
AUTH_SECRET="cambio-esto-por-una-clave-secreta-larga-y-aleatoria"

# Public app URL (optional, used for absolute links in emails/notifications)
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
